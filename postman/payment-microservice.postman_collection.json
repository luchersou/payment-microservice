{
  "info": {
    "name": "Payment Microservice",
    "description": "Every endpoint of the payment-microservice stack, ready to run.\n\n1. `docker compose up --build`\n2. Import this file in Postman (File → Import).\n3. Run the collection (Collection Runner) or call requests one by one.\n\n`orderId` and `paymentId` are filled in by the requests themselves. If the gateway runs on another port (e.g. `API_GATEWAY_PORT=3010`), change the `baseUrl` collection variable.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Orders",
      "description": "Commands are asynchronous: POST and PATCH answer 202 and the saga runs through RabbitMQ. Run the folder in order (Collection Runner) to follow one order end to end.",
      "item": [
        {
          "name": "Create Order",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('202 Accepted', () => pm.response.to.have.status(202));",
                  "const body = pm.response.json();",
                  "pm.test('returns orderId with PENDING_PAYMENT', () => {",
                  "  pm.expect(body.orderId).to.be.a('string');",
                  "  pm.expect(body.status).to.eql('PENDING_PAYMENT');",
                  "});",
                  "pm.collectionVariables.set('orderId', body.orderId);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders"
              ]
            },
            "description": "Accepted with 202. `totalCents` is an integer amount in cents (1999 = 19.99). The returned `orderId` is saved in the `orderId` collection variable for the next requests.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{userId}}\",\n  \"totalCents\": 1999\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Get Order by ID",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Give the saga time: order.created → payment (~1.5s) → result",
                  "setTimeout(() => {}, 3000);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('payment decided: PAID or FAILED', () => {",
                  "  pm.expect(pm.response.json().status).to.be.oneOf(['PAID', 'FAILED']);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/orders/{{orderId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders",
                "{{orderId}}"
              ]
            },
            "description": "Waits ~3s so the payment is decided first. PAID when approved, FAILED when declined (~20% with the simulated gateway)."
          }
        },
        {
          "name": "Get All Orders",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('paginated', () => pm.expect(pm.response.json()).to.have.keys('data', 'meta'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/orders?page=1&limit=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            },
            "description": "Paginated, newest first. `limit` is capped at 100."
          }
        },
        {
          "name": "Cancel Order",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('202 Accepted', () => pm.response.to.have.status(202));"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/orders/{{orderId}}/cancel",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders",
                "{{orderId}}",
                "cancel"
              ]
            },
            "description": "No body. Accepted with 202; a PAID order becomes CANCELLED and its payment REFUNDED. A FAILED order stays FAILED (terminal)."
          }
        },
        {
          "name": "Get Order after Cancel",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Give order.cancel.requested time to be consumed",
                  "setTimeout(() => {}, 2000);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('CANCELLED (or FAILED if the payment was declined)', () => {",
                  "  pm.expect(pm.response.json().status).to.be.oneOf(['CANCELLED', 'FAILED']);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/orders/{{orderId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders",
                "{{orderId}}"
              ]
            },
            "description": "Waits ~2s for the cancel to be processed."
          }
        }
      ]
    },
    {
      "name": "Payments",
      "description": "Read-only, proxied by the gateway to the payment service. Amounts are integer cents.",
      "item": [
        {
          "name": "Get Payment by Order ID",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Give order.cancelled time to reach the payment service",
                  "setTimeout(() => {}, 1500);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('paymentId', body.id);",
                  "pm.test('amount in cents', () => pm.expect(body.amountCents).to.eql(1999));",
                  "pm.test('REFUNDED, DECLINED or CANCELLED', () => {",
                  "  pm.expect(body.status).to.be.oneOf(['REFUNDED', 'DECLINED', 'CANCELLED']);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/payments/order/{{orderId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "payments",
                "order",
                "{{orderId}}"
              ]
            },
            "description": "Saves the payment id in the `paymentId` collection variable. After the cancel above: REFUNDED (was approved) or DECLINED (with `failureReason`)."
          }
        },
        {
          "name": "Get Payment by ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('same payment', () => pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get('paymentId')));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/payments/{{paymentId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "payments",
                "{{paymentId}}"
              ]
            },
            "description": ""
          }
        },
        {
          "name": "Get All Payments",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/payments?page=1&limit=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "payments"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            },
            "description": "Paginated, newest first."
          }
        },
        {
          "name": "Get Payment Statistics",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('byStatus with totalAmountCents', () => {",
                  "  const [first] = pm.response.json().byStatus;",
                  "  pm.expect(first).to.have.keys('status', 'count', 'totalAmountCents');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/payments/stats",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "payments",
                "stats"
              ]
            },
            "description": "Count and total amount (in cents) per payment status."
          }
        }
      ]
    },
    {
      "name": "Validation & Errors",
      "description": "What the gateway answers for bad input or missing resources.",
      "item": [
        {
          "name": "Create Order - decimal amount (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 Bad Request', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders"
              ]
            },
            "description": "`totalCents` must be an integer: 19.99 is rejected.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{userId}}\",\n  \"totalCents\": 19.99\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Create Order - invalid userId (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 Bad Request', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders"
              ]
            },
            "description": "`userId` must be a UUID.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"not-a-uuid\",\n  \"totalCents\": 1999\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Get Order - invalid id (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 Bad Request', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/orders/not-a-uuid",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders",
                "not-a-uuid"
              ]
            },
            "description": "Every `:id` is validated as a UUID."
          }
        },
        {
          "name": "Get Order - not found (404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('404 Not Found', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/orders/00000000-0000-4000-8000-000000000000",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders",
                "00000000-0000-4000-8000-000000000000"
              ]
            },
            "description": ""
          }
        },
        {
          "name": "Get Payment - not found (404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('404 Not Found', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/payments/00000000-0000-4000-8000-000000000000",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "payments",
                "00000000-0000-4000-8000-000000000000"
              ]
            },
