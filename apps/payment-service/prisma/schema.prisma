generator client {
  provider            = "prisma-client"
  output              = "./generated/prisma"
  // Explicit: otherwise inferred from tsconfig, and module=node16 yields ESM
  // output (import.meta) that crashes the CommonJS build at runtime.
  moduleFormat        = "cjs"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

model Payment {
  id            String        @id @default(uuid())
  orderId       String        @unique
  /// Null for a tombstone: the order was cancelled before OrderCreated arrived
  amount        Float?
  status        PaymentStatus @default(PROCESSING)
  /// Why the payment was DECLINED or FAILED, so a republished result keeps it
  failureReason String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model FailedMessage {
  id         String   @id @default(uuid())
  queue      String
  routingKey String
  payload    Json
  error      String?
  createdAt  DateTime @default(now())
  /// Set when the message was republished to its original queue (DLQ replay)
  replayedAt DateTime?

  @@map("failed_messages")
}


/// Events written in the same transaction as the state change they announce,
/// published afterwards by the outbox relay (at-least-once)
model OutboxMessage {
  id            String    @id @default(uuid())
  exchange      String
  routingKey    String
  payload       Json
  correlationId String?
  attempts      Int       @default(0)
  createdAt     DateTime  @default(now())
  publishedAt   DateTime?

  @@index([publishedAt, createdAt])
  @@map("outbox_messages")
}

enum PaymentStatus {
  PROCESSING
  APPROVED
  DECLINED
  REFUNDED
  FAILED
  CANCELLED
}
